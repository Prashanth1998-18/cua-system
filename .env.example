# Copy this file to .env and fill in your values. .env is gitignored.

# OpenAI-compatible LLM endpoint used by `cua discover`.
CUA_LLM_BASE_URL=https://api.openai.com/v1
CUA_LLM_API_KEY=
CUA_LLM_MODEL=

# Browser settings
CUA_BROWSER_HEADLESS=true
CUA_CDP_PORT=9222
CUA_SCREENSHOT_DIR=evidence/screenshots

# Escalation / operator console
CUA_OPERATOR_PORT=8080

# Output directories
CUA_ARTIFACT_DIR=evidence/artifacts
CUA_LOG_DIR=evidence/logs
